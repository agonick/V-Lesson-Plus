{
  "manifest_version": 3,
  "name": "V-Lesson Plus",
  "version": "1.1.0",
  "description": "An unofficial browser extension for enhancing Uninettuno University lessons.",
  "browser_specific_settings": {
    "gecko": {
      "id": "v-lesson-plus@agonick.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "V-Lesson Plus",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["https://www.uninettunouniversity.net/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
